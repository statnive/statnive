# Version control
/.git
/.github

# Node.js
/node_modules
package.json
package-lock.json

# Build tool configuration
vite.config.ts
vitest.config.ts
tsconfig.json
playwright.config.ts

# Source files (compiled versions ship in public/)
# Tracker source ships for WP.org Guideline 4 (human-readable code).
# React source excluded — public repo link in readme.txt.
/resources/react

# Dead premium add-on stubs — not initialized, not functional.
# Excluded to avoid Guideline 5 "trialware" confusion during WP.org review.
# Code remains in the git repo for future Pro development.
/src/Addon

# PHP dev tooling (composer.json ships — PCP expects it alongside vendor/)
composer.lock
phpstan.neon
phpstan-baseline.neon
.phpcs.xml.dist
phpunit.xml.dist
phpunit-integration.xml
.phpunit.result.cache

# JavaScript dev tooling
bun.lock

# Vendor dev-only packages (runtime deps: geoip2, matomo, maxmind*, mustangostang, psr)
# Also exclude test dirs inside runtime packages
/vendor/*/tests
/vendor/*/*/tests
/vendor/*/*/*/tests
/vendor/*/ext/tests
phpunit.xml
/vendor/bin
/vendor/coenjacobs
/vendor/dealerdirect
/vendor/myclabs
/vendor/nikic
/vendor/phar-io
/vendor/php-stubs
/vendor/phpcsstandards
/vendor/phpstan
/vendor/phpunit
/vendor/sebastian
/vendor/squizlabs
/vendor/staabm
/vendor/szepeviktor
/vendor/theseer
/vendor/wp-coding-standards
/vendor/yoast
/vendor/symfony
/vendor/phpcompatibility
/vendor/*/examples
/vendor/*/*/examples

# Dev-only scripts and CI configs that ship inside runtime composer packages.
# WordPress.org's automated submission gate rejects release.sh, build scripts,
# and similar maintainer artifacts even when nested in vendor/ — caught by
# v0.4.12 first upload (maxmind/web-service-common/dev-bin/release.sh).
/vendor/*/dev-bin
/vendor/*/*/dev-bin
/vendor/*/.github
/vendor/*/*/.github
/vendor/*/.gitlab-ci.yml
/vendor/*/*/.gitlab-ci.yml
/vendor/*/.travis.yml
/vendor/*/*/.travis.yml
/vendor/*/.circleci
/vendor/*/*/.circleci
/vendor/*/Makefile
/vendor/*/*/Makefile
/vendor/*/CHANGELOG.md
/vendor/*/*/CHANGELOG.md
/vendor/*/CONTRIBUTING.md
/vendor/*/*/CONTRIBUTING.md

# Legacy PHP-4 directories in vendor packages. spyc and similar libs ship
# a php4/ subdir with .php4-extension files that composer never autoloads
# (the autoload manifest points at Spyc.php only). .php4 is non-standard
# and a likely future WP.org reviewer flag.
/vendor/*/php4
/vendor/*/*/php4

# PECL C-extension build artefacts inside vendor packages. maxmind-db/reader
# ships an optional ext/ subdir (maxminddb.c, php_maxminddb.h, config.m4,
# config.w32) for users who compile the speed-optimised C reader via PECL.
# WordPress plugins never compile C extensions, the composer autoload points
# only at src/, and unusual extensions like .c / .h / .m4 / .w32 are likely
# WP.org reviewer flags. package.xml is the PECL package manifest.
/vendor/*/ext
/vendor/*/*/ext
/vendor/*/package.xml
/vendor/*/*/package.xml

# Tests
/tests
/bin

# Dev environment
.wp-env.json
blueprint.json

# Artifacts
/playwright-report
/test-results
/coverage
screenshot-*.png

# Docs (readme.txt is the WP.org file; internal runbooks live in /docs and stay out of dist)
README.md
CHANGELOG.md
/docs

# Meta
.distignore
.gitignore
.editorconfig

# Local dev environment — must NEVER ship (contains paths + credentials).
# WordPress.org Plugin Check rejects any dotfile in the ZIP (hidden_files rule).
.env
.env.local
.env.*

# Git hooks (host-side dev tooling, not runtime)
.githooks

# Repo-only artifacts (SVN assets staged separately, evidence packs per release)
.wordpress-org
/releases
/statnive-dist

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
