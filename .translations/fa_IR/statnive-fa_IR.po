#: src/Privacy/ComplianceAuditor.php:88
msgid "Do Not Track honored"
msgstr "Do Not Track رعایت می‌شود"

#: src/Privacy/ComplianceAuditor.php:91
msgid "DNT header is respected."
msgstr "هدر DNT رعایت می‌شود."

#: src/Privacy/ComplianceAuditor.php:92
msgid "DNT header is not honored. Consider enabling for privacy compliance."
msgstr "هدر DNT رعایت نمی‌شود. برای انطباق با حریم خصوصی، فعال کردن آن را در نظر بگیرید."

#: src/Privacy/ComplianceAuditor.php:105
msgid "Global Privacy Control honored"
msgstr "Global Privacy Control رعایت می‌شود"

#: src/Privacy/ComplianceAuditor.php:108
msgid "GPC header is respected."
msgstr "هدر GPC رعایت می‌شود."

#: src/Privacy/ComplianceAuditor.php:109
msgid "GPC header is not honored. Required under some US state laws."
msgstr "هدر GPC رعایت نمی‌شود. بر اساس برخی قوانین ایالتی آمریکا الزامی است."

#: src/Privacy/ComplianceAuditor.php:123
msgid "Data retention configured"
msgstr "نگهداری داده‌ها پیکربندی شد"

#. translators: %1$d: number of days, %2$s: retention mode.
#: src/Privacy/ComplianceAuditor.php:127
#, php-format
msgid "Data retained for %1$d days (%2$s mode)."
msgstr "داده‌ها برای %1$d روز نگهداری می‌شوند (حالت %2$s)."

#: src/Privacy/ComplianceAuditor.php:128
msgid "Data retained forever. Consider setting a retention period for compliance."
msgstr "داده‌ها برای همیشه نگهداری می‌شوند. برای انطباق، تعیین یک دوره نگهداری را در نظر بگیرید."

#: src/Privacy/ComplianceAuditor.php:142
msgid "Privacy policy page published"
msgstr "صفحه سیاست حریم خصوصی منتشر شد"

#: src/Privacy/ComplianceAuditor.php:145
msgid "Privacy policy page is published. Statnive content auto-generated."
msgstr "صفحه سیاست حریم خصوصی منتشرشده است. محتوای Statnive به‌صورت خودکار تولید شد."

#: src/Privacy/ComplianceAuditor.php:146
msgid "No published privacy policy page found. Create one in Settings → Privacy."
msgstr "هیچ صفحه سیاست حریم خصوصی منتشرشده‌ای یافت نشد. یکی را در تنظیمات ← حریم خصوصی ایجاد کنید."

#: src/Privacy/ComplianceAuditor.php:159
msgid "No raw IP addresses stored"
msgstr "هیچ آدرس IP خامی ذخیره نمی‌شود"

#: src/Privacy/ComplianceAuditor.php:161
msgid "IP addresses are discarded immediately after hashing and GeoIP lookup."
msgstr "آدرس‌های IP بلافاصله پس از hash شدن و جست‌وجوی GeoIP دور انداخته می‌شوند."

#: src/Privacy/ComplianceAuditor.php:181
msgid "Daily salt rotation active"
msgstr "چرخش روزانه salt فعال است"

#. translators: %s: datetime of last salt rotation.
#: src/Privacy/ComplianceAuditor.php:185
#, php-format
msgid "Last rotation: %s"
msgstr "آخرین چرخش: %s"

#: src/Privacy/ComplianceAuditor.php:186
msgid "Salt rotation may not be running. Check WP-Cron."
msgstr "ممکن است چرخش salt در حال اجرا نباشد. WP-Cron را بررسی کنید."

#: src/Privacy/ComplianceAuditor.php:198
msgid "Cookie-free tracking"
msgstr "اندازه‌گیری بدون کوکی"

#: src/Privacy/ComplianceAuditor.php:200
msgid "Statnive uses no cookies, localStorage, or sessionStorage by design."
msgstr "Statnive بنا به طراحی از هیچ کوکی، localStorage یا sessionStorage استفاده نمی‌کند."

#: src/Privacy/ComplianceAuditor.php:213
#: src/Privacy/ComplianceAuditor.php:222
msgid "Data purge operational"
msgstr "پاک‌سازی داده‌ها فعال است"

#: src/Privacy/ComplianceAuditor.php:215
msgid "Retention mode is \"forever\" — no purge needed."
msgstr "حالت نگهداری روی «همیشه» تنظیم شده است — به پاک‌سازی نیازی نیست."

#: src/Privacy/ComplianceAuditor.php:225
msgid "Data purge cron is scheduled."
msgstr "cron پاک‌سازی داده‌ها زمان‌بندی شده است."

#: src/Privacy/ComplianceAuditor.php:226
msgid "Data purge cron not scheduled. Deactivate and reactivate the plugin."
msgstr "cron پاک‌سازی داده‌ها زمان‌بندی نشده است. افزونه را غیرفعال و دوباره فعال کنید."

#: src/Privacy/ComplianceAuditor.php:239
msgid "HTTPS enabled"
msgstr "HTTPS فعال است"

#: src/Privacy/ComplianceAuditor.php:242
msgid "Site is served over HTTPS."
msgstr "وب‌سایت بر روی HTTPS ارائه می‌شود."

#: src/Privacy/ComplianceAuditor.php:243
msgid "Site not using HTTPS. Analytics data transmitted in plaintext."
msgstr "وب‌سایت از HTTPS استفاده نمی‌کند. داده‌های آنالیتیکس به‌صورت متن ساده منتقل می‌شوند."

#. translators: %d: number of sessions anonymized
#: src/Privacy/PrivacyEraser.php:124
#, php-format
msgid "Anonymized %d analytics session(s). Aggregate statistics preserved."
msgstr "%d جلسه آنالیتیکس ناشناس‌سازی شد. آمار تجمیعی حفظ شد."

#: src/Privacy/PrivacyExporter.php:102
msgid "Session Start"
msgstr "شروع جلسه"

#: src/Privacy/PrivacyExporter.php:106
msgid "Session End"
msgstr "پایان جلسه"

#: src/Privacy/PrivacyExporter.php:107
msgid "Active"
msgstr "فعال"

#: src/Privacy/PrivacyExporter.php:110
msgid "Pages Viewed"
msgstr "صفحات مشاهده‌شده"

#: src/Privacy/PrivacyExporter.php:114
msgid "Duration (seconds)"
msgstr "مدت زمان (ثانیه)"

#: src/Privacy/PrivacyExporter.php:139
msgid "Pages Visited"
msgstr "صفحات بازدیدشده"

#: src/Privacy/PrivacyExporter.php:146
msgid "Statnive Analytics Sessions"
msgstr "جلسات آنالیتیکس Statnive"

#: src/Privacy/PrivacyExporter.php:147
msgid "Analytics sessions recorded by Statnive. No IP addresses or cookies are stored."
msgstr "جلسات آنالیتیکس ثبت‌شده توسط Statnive. هیچ آدرس IP یا کوکی ذخیره نمی‌شود."

#: src/Privacy/PrivacyPolicyGenerator.php:55
msgid "Analytics (Statnive)"
msgstr "آنالیتیکس (Statnive)"

#: src/Privacy/PrivacyPolicyGenerator.php:56
msgid "This website uses Statnive, a privacy-first analytics plugin that runs entirely on our server. No data is shared with third-party services."
msgstr "این وب‌سایت از Statnive استفاده می‌کند، یک افزونه آنالیتیکس حریم‌خصوصی‌محور که به‌طور کامل بر روی سرور ما اجرا می‌شود. هیچ داده‌ای با سرویس‌های شخص ثالث به اشتراک گذاشته نمی‌شود."

#: src/Privacy/PrivacyPolicyGenerator.php:59
msgid "Cookies & Tracking"
msgstr "کوکی‌ها و اندازه‌گیری"

#: src/Privacy/PrivacyPolicyGenerator.php:60
msgid "Statnive does not use cookies, localStorage, sessionStorage, or any form of browser fingerprinting. Visitor identification uses a daily-rotating cryptographic hash that cannot be reversed or used to track individuals across days."
msgstr "Statnive از کوکی، localStorage، sessionStorage یا هیچ‌گونه اثرانگشت‌گیری مرورگر استفاده نمی‌کند. شناسایی بازدیدکنندگان با یک hash رمزنگاری‌شده با چرخش روزانه انجام می‌شود که قابل بازگشت نیست و نمی‌توان از آن برای پیگیری افراد در طول روزها استفاده کرد."

#: src/Privacy/PrivacyPolicyGenerator.php:63
msgid "Data Collected"
msgstr "داده‌های جمع‌آوری‌شده"

#: src/Privacy/PrivacyPolicyGenerator.php:64
msgid "We collect the following anonymized data for each page visit:"
msgstr "ما داده‌های ناشناس‌سازی‌شده زیر را برای هر بازدید صفحه جمع‌آوری می‌کنیم:"

#: src/Privacy/PrivacyPolicyGenerator.php:66
msgid "Page URL visited (without query parameters)"
msgstr "نشانی URL صفحه بازدیدشده (بدون پارامترهای پرس‌وجو)"

#: src/Privacy/PrivacyPolicyGenerator.php:67
msgid "Referrer URL (domain only, query parameters stripped)"
msgstr "نشانی URL ارجاع‌دهنده (تنها دامنه، پارامترهای پرس‌وجو حذف می‌شوند)"

#: src/Privacy/PrivacyPolicyGenerator.php:68
msgid "Country and city (derived from IP, which is immediately discarded)"
msgstr "کشور و شهر (استخراج‌شده از IP که بلافاصله دور انداخته می‌شود)"

#: src/Privacy/PrivacyPolicyGenerator.php:69
msgid "Device type, browser, and operating system"
msgstr "نوع دستگاه، مرورگر و سیستم‌عامل"

#: src/Privacy/PrivacyPolicyGenerator.php:70
msgid "Screen resolution, language, and timezone"
msgstr "رزولوشن صفحه، زبان و منطقه زمانی"

#: src/Privacy/PrivacyPolicyGenerator.php:74
msgid "IP Address Handling"
msgstr "مدیریت آدرس IP"

#: src/Privacy/PrivacyPolicyGenerator.php:75
msgid "Your IP address is never stored. It is used only momentarily to determine your approximate geographic location and to generate a one-way cryptographic hash for visit counting. The IP is discarded immediately after processing and cannot be recovered from the stored hash."
msgstr "آدرس IP شما هرگز ذخیره نمی‌شود. تنها لحظه‌ای برای تعیین موقعیت جغرافیایی تقریبی شما و تولید یک hash رمزنگاری‌شده یک‌طرفه برای شمارش بازدید استفاده می‌شود. IP بلافاصله پس از پردازش دور انداخته می‌شود و از hash ذخیره‌شده قابل بازیابی نیست."

#: src/Privacy/PrivacyPolicyGenerator.php:76
msgid "When no IP-derived geolocation source is configured, an approximate country may be inferred from your browser’s timezone setting. The timezone string is processed on this site’s server only and is not transmitted to any third party."
msgstr "زمانی که هیچ منبع موقعیت‌یابی جغرافیایی مبتنی بر IP پیکربندی نشده باشد، ممکن است کشوری تقریبی از تنظیمات منطقه زمانی مرورگر شما استنباط شود. رشته منطقه زمانی تنها بر روی سرور این وب‌سایت پردازش می‌شود و به هیچ شخص ثالثی منتقل نمی‌شود."

#: src/Privacy/PrivacyPolicyGenerator.php:79
msgid "Consent"
msgstr "رضایت"

#: src/Privacy/PrivacyPolicyGenerator.php:81
msgid "Because Statnive uses no cookies and stores no personal data, analytics run in cookieless mode without requiring consent under most privacy regulations."
msgstr "از آنجا که Statnive از هیچ کوکی استفاده نمی‌کند و هیچ داده شخصی ذخیره نمی‌کند، آنالیتیکس در حالت بدون کوکی اجرا می‌شود و بر اساس بیشتر مقررات حریم خصوصی نیازی به رضایت ندارد."

#: src/Privacy/PrivacyPolicyGenerator.php:83
msgid "Analytics are disabled until you provide explicit consent through our cookie/consent banner. No data is collected before consent is granted."
msgstr "آنالیتیکس تا زمانی که شما از طریق بنر کوکی/رضایت ما اجازه صریح ندهید، غیرفعال است. پیش از اعطای رضایت هیچ داده‌ای جمع‌آوری نمی‌شود."

#: src/Privacy/PrivacyPolicyGenerator.php:85
msgid "Analytics are active for all visitors. You may opt out using your browser's Do Not Track or Global Privacy Control settings."
msgstr "آنالیتیکس برای همه بازدیدکنندگان فعال است. می‌توانید با استفاده از تنظیمات Do Not Track یا Global Privacy Control مرورگر خود انصراف دهید."

#: src/Privacy/PrivacyPolicyGenerator.php:90
msgid "Do Not Track & Global Privacy Control"
msgstr "Do Not Track و Global Privacy Control"

#: src/Privacy/PrivacyPolicyGenerator.php:93
msgid "Do Not Track (DNT)"
msgstr "Do Not Track (DNT)"

#: src/Privacy/PrivacyPolicyGenerator.php:96
