msgstr "保持期間を設定"

#. translators: %1$d: days, %2$s: mode
#: src/Privacy/SiteHealthIntegration.php:115
#, php-format
msgid "Statnive: %1$d-day retention (%2$s)"
msgstr "Statnive: %1$d 日間の保持期間 (%2$s)"

#: src/Privacy/SiteHealthIntegration.php:124
