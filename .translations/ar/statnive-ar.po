#: src/Privacy/ComplianceAuditor.php:108
msgid "GPC header is respected."
msgstr "يتم احترام ترويسة GPC."

#: src/Privacy/ComplianceAuditor.php:109
msgid "GPC header is not honored. Required under some US state laws."
msgstr "ترويسة GPC لا يتم احترامها. مطلوبة بموجب بعض قوانين الولايات الأمريكية."

#: src/Privacy/ComplianceAuditor.php:123
msgid "Data retention configured"
msgstr "مدة الاحتفاظ بالبيانات مُهيَّأة"

#. translators: %1$d: number of days, %2$s: retention mode.
#: src/Privacy/ComplianceAuditor.php:127
