msgstr "Statnive: обнаружено несоответствие версий плагина."

#. translators: 1: stored schema version, 2: running plugin version
#: src/Database/Migrator.php:263
#, php-format
msgid "Your database schema is at version %1$s but the running plugin is version %2$s. This may happen if you downgraded the plugin. Please re-install the latest version to avoid data inconsistencies."
msgstr "Схема Вашей базы данных имеет версию %1$s, а запущенный плагин — версию %2$s. Это может произойти при откате плагина на более раннюю версию. Переустановите последнюю версию, чтобы избежать рассогласования данных."

#: src/Plugin.php:124
msgid "You do not have permission to activate plugins."
msgstr "У Вас нет прав на активацию плагинов."

#: src/Plugin.php:125
#: src/Plugin.php:141
#: src/Plugin.php:157
msgid "Plugin Activation Error"
msgstr "Ошибка активации плагина"

